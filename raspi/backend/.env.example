# Sat Set Tap — contoh konfigurasi backend
# Salin file ini menjadi backend/.env lalu isi sesuai lingkungan.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# Serial / hardware
SERIAL_PORT=/dev/ttyUSB0

# Server dashboard
DASHBOARD_PORT=8080

# Token default per peserta saat registrasi manual/CSV tanpa kolom token
TOKEN_DEFAULT=3
